# Gemini (live voice + vision). Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Prices from Google Shopping / eBay via SerpAPI. Free plan: https://serpapi.com/users/sign_up
SERPAPI_KEY=

# Models (defaults shown).
# LIVE_MODEL=gemini-3.8-live
# VISION_MODEL=gemini-3.5-flash

# Policyholder locale. COMPARE_COUNTRY prices the same sample in a second market.
COUNTRY=IN
COMPARE_COUNTRY=US

# Physical side length of the ArUco marker's black square, measured with a tape.
# Printed A4 page: ~18.0. On a laptop screen: measure it on your screen once.
MARKER_SIZE_CM=15.0

# Books priced at or above this (in the claim currency) go to human appraisal.
APPRAISAL_THRESHOLD=10000

# Optional cap on price searches per sweep (development runs). Leave empty for real sweeps.
PRICE_SEARCH_BUDGET=

# Where sweeps (frames, packets, reports) are written.
SWEEPS_DIR=sweeps
